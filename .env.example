# =============================================================================
# SteKir Cakes — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
#
# Restart `npm run dev` after changes.
#
# Rules:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — never put
#   secrets there (service role keys, bot tokens, Resend keys, etc.).
# - Do not commit `.env.local` or any file with real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase (required for auth, orders, reviews, admin, catalog from DB)
# Dashboard: Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Needed for placing guest orders, Telegram login, account delete,
# admin mutations, and review submission.
# NEVER expose this key in client code or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase → Authentication → URL Configuration:
#   Site URL:        http://localhost:3000  (or your production domain)
#   Redirect URLs:   http://localhost:3000/auth/callback
#                    https://your-domain.com/auth/callback
#
# Enable Email provider for registration / password reset / magic links.
# Enable Google (and other providers) under Authentication → Providers as needed.


# -----------------------------------------------------------------------------
# Email (Resend) — order confirmations, contact form
# Without RESEND_API_KEY, checkout and contact form emails will fail.
# https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives new order and contact notifications.
# Falls back to hello@stekircakes.com if unset.
OWNER_EMAIL=hello@stekircakes.com

# Verified sender in Resend (must match a domain you verified there).
RESEND_FROM_EMAIL="SteKir Cakes <hello@stekircakes.com>"


# -----------------------------------------------------------------------------
# Google Maps — delivery zone map on the contact page
# Optional: map is hidden if the key is missing.
# Enable Maps JavaScript API in Google Cloud Console.
# Restrict the key by HTTP referrer (localhost + production domain).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# OAuth sign-in (Supabase Auth)
# Google is shown by default once enabled in Supabase Dashboard.
# Set optional providers to "true" to show extra buttons in the login UI.
# Each provider must also be configured under Supabase → Authentication → Providers.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_OAUTH_APPLE=true
# NEXT_PUBLIC_OAUTH_FACEBOOK=true


# -----------------------------------------------------------------------------
# Telegram Login
# Optional. Shows the Telegram widget on login / register when username is set.
#
# 1. Create a bot via @BotFather
# 2. Link your site domain: /setdomain → choose bot → enter domain
#    Dev:  localhost
#    Prod: your-domain.com
# 3. Paste bot username (without @) and token below
#
# TELEGRAM_BOT_TOKEN is server-only — used to verify Telegram auth signatures.
# Requires SUPABASE_SERVICE_ROLE_KEY (see above).
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername
# TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
